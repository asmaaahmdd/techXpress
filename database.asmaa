create database projecttech
use projecttech
CREATE TABLE users (
    id INT identity (1,1) PRIMARY KEY,
    name VARCHAR(100),
    email VARCHAR(100),
    address TEXT
);

CREATE TABLE orders (
    id INT identity (1,1) PRIMARY KEY,
    user_id INT,
    product_name VARCHAR(255),
    total_amount DECIMAL(10,2),
    status VARCHAR(50),
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);
INSERT INTO users (name, email, address)
